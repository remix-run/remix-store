{
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": [
      "node",
      "remix/assets/types/hmr",
      "vite/client",
      "@hiogawa/vite-plugin-fullstack/types",
      "@shopify/oxygen-workers-types"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "remix/ui",
    "plugins": [
      {
        "name": "gql.tada/ts-plugin",
        "schemas": [
          {
            "name": "storefront",
            "schema": "./storefront-2026-04.schema.json",
            "tadaOutputLocation": "storefront-graphql-env.d.ts"
          },
          {
            "name": "customer-account",
            "schema": "./node_modules/@shopify/hydrogen/dist/customer-account.schema.json",
            "tadaOutputLocation": "customer-account-graphql-env.d.ts"
          }
        ],
        "trackFieldUsage": false
      }
    ],
    "noEmit": true
  },
  "exclude": ["dist"]
}
