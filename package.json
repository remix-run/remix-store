{
  "name": "remix-store",
  "version": "2024.4.7",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "shopify hydrogen build --codegen",
    "dev": "shopify hydrogen dev --codegen",
    "preview": "shopify hydrogen preview --build",
    "lint": "oxlint . && oxfmt --check .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "codegen": "shopify hydrogen codegen",
    "format": "oxfmt .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@shopify/cli-hydrogen": "13.0.3",
    "@shopify/hydrogen": "2026.4.4",
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "embla-carousel": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "graphql": "16.14.0",
    "graphql-tag": "2.12.7",
    "isbot": "5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.2",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "5.0.7",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@shopify/cli": "4.5.2",
    "@shopify/hydrogen-codegen": "0.3.3",
    "@shopify/mini-oxygen": "4.2.1",
    "@shopify/oxygen-workers-types": "4.2.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "24.12.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "happy-dom": "20.11.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-icons-spritesheet": "3.1.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "overrides": {
      "undici": "7.29.0",
      "qs": "6.15.3",
      "ws": "8.21.1",
      "cookie": "1.0.2"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react-router": "7.18.2",
        "@react-router/dev": "7.18.2",
        "@shopify/mini-oxygen": "4.2.0"
      }
    }
  }
}
