{
  "name": "remix-store",
  "private": true,
  "version": "2024.4.7",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "shopify hydrogen deploy --preview",
    "lint": "prettier --check .",
    "typecheck": "tsc --noEmit && hydrogen gql check --fail-on-warn",
