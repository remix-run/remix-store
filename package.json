{
  "name": "remix-store",
  "version": "2024.4.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.node.ts",
    "hmr": "NODE_ENV=development node --env-file-if-exists=.env hmr.node.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.node.ts",
    "dev:oxygen": "vite dev",
    "build": "pnpm build:oxygen",
    "build:oxygen": "vite build",
    "preview": "pnpm preview:oxygen",
    "preview:oxygen": "vite preview",
    "deploy": "pnpm deploy:oxygen",
    "deploy:oxygen": "shopify hydrogen deploy --preview",
    "lint": "oxlint . && oxfmt --check .",
    "typecheck": "tsc --noEmit && hydrogen gql check --fail-on-warn && node scripts/check-admin-graphql.mjs",
    "format": "oxfmt .",
    "test": "remix test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@shopify/hydrogen": "0.0.0-preview-116d5d7-20260730141607",
    "remix": "3.0.0-beta.10",
    "sanitize-html": "2.17.6"
  },
  "devDependencies": {
    "@hiogawa/vite-plugin-fullstack": "0.0.11",
    "@shopify/cli": "4.5.2",
    "@shopify/mini-oxygen": "4.2.1",
    "@shopify/oxygen-workers-types": "4.2.0",
    "@types/node": "24.12.4",
    "@types/sanitize-html": "2.16.1",
    "graphql": "16.14.0",
    "magic-string": "0.30.21",
    "oxc-parser": "0.141.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "vite": "8.2.0"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "overrides": {
      "@remix-run/static-middleware>@remix-run/fetch-router": "0.21.0",
      "undici": "7.29.0",
      "qs": "6.15.3",
      "ws": "8.21.1",
      "cookie": "1.0.2"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@hiogawa/vite-plugin-fullstack>vite": "8"
      }
    }
  }
}
