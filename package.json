    "test": "NODE_ENV=test NODE_OPTIONS=--import=./test/assets-stub.js remix test"
  },
  "dependencies": {
    "@shopify/hydrogen": "0.0.0-preview-116d5d7-20260730141607",
    "remix": "3.0.0-beta.5"
  },
  "devDependencies": {
    "@hiogawa/vite-plugin-fullstack": "0.0.11",
    "@shopify/cli": "4.5.2",
    "@shopify/mini-oxygen": "4.2.1",
    "@shopify/oxygen-workers-types": "4.2.0",
    "@types/node": "24.12.4",
    "magic-string": "0.30.21",
    "oxc-parser": "0.141.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "8.2.0"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "overrides": {
      "undici": "7.29.0",
      "qs": "6.15.3",
      "ws": "8.21.1",
      "liquidjs": "10.27.2",
      "lodash": "4.18.1",
      "cookie": "1.0.2",
      "form-data": "4.0.6"
    },
    "peerDependencyRules": {
