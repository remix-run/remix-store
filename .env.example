# Remix Store Environment Variables
#
# ⚠️ SECURITY: Never commit the actual .env file. This contains placeholders only.
#
# See ENVIRONMENT_VARIABLE_CONTRACT.md for complete documentation.

# =============================================================================
# REQUIRED VARIABLES
# =============================================================================

# ── Shopify Store Configuration ──────────────────────────────────────────────

# Shopify store domain (without https://)
# Example: example.myshopify.com or shop.example.com
# Public: Safe to expose client-side (used in CSP, meta tags)
PUBLIC_STORE_DOMAIN=[REDACTED:ENV_VALUE]

# Shopify Storefront API - PRIVATE token
# Server-only token for GraphQL queries via createStorefrontClient({ type: 'private' })
# ⚠️ SECURITY: Never expose client-side. Enables server-side queries to Storefront API.
# https://shopify.dev/docs/api/storefront/latest#authentication
PRIVATE_STOREFRONT_API_TOKEN=[REDACTED:SECRET]

# Shopify Storefront API - PUBLIC token
# Client-safe token for Shopify Analytics consent configuration
# Used in: @shopify/hydrogen analytics consent.storefrontAccessToken
# IMPORTANT: Distinct from PRIVATE token - NOT the same credential!
# Migration: Audit experimental analytics in Phase 1.1; may be retired if consent not used
PUBLIC_STOREFRONT_API_TOKEN=[REDACTED:SECRET]

# Shopify storefront ID for analytics tracking
# Example: 1000020043
# Public: Required client-side for Shopify Analytics
PUBLIC_STOREFRONT_ID=[REDACTED:ENV_VALUE]

# =============================================================================
# OPTIONAL VARIABLES
# =============================================================================

# ── Checkout Configuration ───────────────────────────────────────────────────

# Custom checkout domain (e.g., checkout.remix.run)
# Used in: CSP configuration and Shopify Analytics consent config
# NOT used for: Checkout URL construction (Shopify generates those)
# Public: Safe client-side
# PUBLIC_CHECKOUT_DOMAIN=[REDACTED:ENV_VALUE]

# ── SEO & Robots ─────────────────────────────────────────────────────────────

# Shopify shop ID (numeric, parsed from GID) for robots.txt
# Example: 12345678 (from gid://shopify/Shop/12345678)
# Current implementation queries shop.id via Storefront API and parses GID
# Optional env fallback for robots.txt route only
# Public: Used only in robots.txt generation
# SHOP_ID=[REDACTED:ENV_VALUE]

# =============================================================================
# LEGACY VARIABLES (Phase 2.17 Audit Required)
# =============================================================================

# Session secret for signing cookie sessions (cart, discount codes)
# CURRENT USAGE: Used by createCookieSessionStorage for signing (not encryption)
# Receives ONE secret (not comma-separated): [env.SESSION_SECRET]
# EXPERIMENTAL USAGE: None (uses unsigned Hydrogen cart cookies via createCartCookie)
# MIGRATION: Classify as legacy/pending Phase 2.17 audit
# ⚠️ SECURITY: Server-only. Never expose client-side.
# Production: Use long random string (e.g., openssl rand -base64 32)
# SESSION_SECRET=[REDACTED:SECRET]

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
#
# Oxygen (Cloudflare Workers):
#   - Configure via Shopify admin → Hydrogen storefront settings
#   - Secure variables: PRIVATE_STOREFRONT_API_TOKEN
#   - Public variables: All others (still via env, not hardcoded)
#
# Fly (Node.js):
#   - Configure via: fly secrets set KEY=value
#   - All variables treated as secrets (encrypted by Fly)
#
# ⚠️ LIVE STORE WARNING: These credentials connect to a live public Shopify store.
# Do NOT use production tokens in local development. Create a development store
# or use separate API credentials for testing.
#
# See ENVIRONMENT_VARIABLE_CONTRACT.md for:
#   - Complete migration mapping (current → final)
#   - Public/private classification
#   - Security requirements
#   - Oxygen vs Fly configuration
