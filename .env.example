# Remix Store Environment Variables
#
# SECURITY: Never commit the actual .env file. This .env.example contains
# documentation and placeholder values only.
#
# See ENVIRONMENT_VARIABLE_CONTRACT.md for complete documentation.

# =============================================================================
# REQUIRED VARIABLES
# =============================================================================

# ── Shopify Store Configuration ──────────────────────────────────────────────

# Shopify store domain (without https://)
# Example: example.myshopify.com or shop.example.com
# Public: Safe to expose client-side
PUBLIC_STORE_DOMAIN=[REDACTED:ENV_VALUE]

# Shopify Storefront API access token
# CURRENT (React Router 7): PUBLIC_STOREFRONT_API_TOKEN
# MIGRATED (Remix 3): PRIVATE_STOREFRONT_API_TOKEN
#
# ⚠️ SECURITY: Despite "public" in Shopify's API naming, this token MUST be
# server-only. It enables unrestricted query execution and access to
# unpublished content. Never expose client-side.
#
# Current implementation uses PUBLIC_STOREFRONT_API_TOKEN (misleading name).
# Post-migration will use PRIVATE_STOREFRONT_API_TOKEN (correct security level).
# Both are included below for transition compatibility.

# Current (React Router 7 + Hydrogen 2026.4.4):
PUBLIC_STOREFRONT_API_TOKEN=[REDACTED:ENV_VALUE]

# Post-migration (Remix 3 + Hydrogen preview) - same value, different name:
# PRIVATE_STOREFRONT_API_TOKEN=[REDACTED:ENV_VALUE]

# Shopify storefront ID for analytics tracking
# Example: 1000020043
# Public: Required client-side for Shopify Analytics
PUBLIC_STOREFRONT_ID=[REDACTED:ENV_VALUE]

# ── Session Management ───────────────────────────────────────────────────────

# Secret key for cookie session storage encryption
# Production: Use a long random string (e.g., `openssl rand -base64 32`)
# Local dev: Can use placeholder value below
# Supports key rotation: Comma-separated secrets, first is active
#
# ⚠️ SECURITY: Server-only. Compromise allows session hijacking and cart takeover.
SESSION_SECRET=[REDACTED:ENV_VALUE]

# =============================================================================
# OPTIONAL VARIABLES
# =============================================================================

# ── Checkout Configuration ───────────────────────────────────────────────────

# Custom checkout domain (e.g., checkout.remix.run)
# If not set, falls back to shop's primary domain
# Public: Used in analytics consent configuration
# PUBLIC_CHECKOUT_DOMAIN=[REDACTED:ENV_VALUE]

# ── SEO & Robots ─────────────────────────────────────────────────────────────

# Shopify shop ID for robots.txt checkout path blocking
# Example: 12345678
# If not set, robots.txt omits /{shopId}/checkouts disallow rule
# Public: Used only in robots.txt generation
# SHOP_ID=[REDACTED:ENV_VALUE]

# ── Feature Flags ────────────────────────────────────────────────────────────

# Enable Shopify Inbox chat widget
# Set to "true" to enable, any other value (or unset) disables
# NOT IN PHASE 2 SCOPE (Tier 3 backlog) - experimental repo only
# Public: Feature flag for widget rendering
# PUBLIC_SHOPIFY_INBOX_ENABLED=[REDACTED:ENV_VALUE]

# =============================================================================
# PHASE 2.14 VARIABLES (Subscribe/Back-in-Stock)
# =============================================================================

# Shopify Admin API access token for customer operations
# Required scopes: write_customers, read_customers
#
# ⚠️ SECURITY: Highest sensitivity. Admin API write access. Never log this value.
# Never expose client-side. Must implement rate limiting. Avoid logging customer PII.
#
# Not yet required - will be added in Phase 2.14 implementation
# ADMIN_ACCESS_TOKEN=shpat_...

# =============================================================================
# MIGRATION NOTES
# =============================================================================
#
# Current stack (React Router 7 + Hydrogen 2026.4.4):
#   - Uses PUBLIC_STOREFRONT_API_TOKEN (misleading name - actually server-only)
#   - Uses SESSION_SECRET for cookie sessions
#   - Uses PUBLIC_CHECKOUT_DOMAIN (optional)
#   - Does not use SHOP_ID, PUBLIC_SHOPIFY_INBOX_ENABLED, or ADMIN_ACCESS_TOKEN
#
# Post-migration stack (Remix 3 + Hydrogen preview):
#   - Renames PUBLIC_STOREFRONT_API_TOKEN → PRIVATE_STOREFRONT_API_TOKEN
#     (same value, corrected security classification)
#   - Adds SHOP_ID (optional, for robots.txt)
#   - Adds PUBLIC_SHOPIFY_INBOX_ENABLED (optional, Tier 3 feature)
#   - Adds ADMIN_ACCESS_TOKEN (Phase 2.14, subscribe/back-in-stock)
#   - SESSION_SECRET usage to be audited in Phase 2.17
#
# See ENVIRONMENT_VARIABLE_CONTRACT.md for:
#   - Complete migration mapping
#   - Security requirements
#   - Oxygen vs Fly configuration
#   - Per-variable documentation
