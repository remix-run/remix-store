# The populated public values below target https://shop.remix.run.
# A private Storefront token must be pulled separately before local development.
#
# THIS IS A PUBLIC STORE -- all purchases made will place real orders
# that will really take your money and will tell the Remix team to really
# send you some great merch

PUBLIC_STOREFRONT_ID=1000020043
PUBLIC_STORE_DOMAIN=2d1167-3d.myshopify.com

# Required server-only Storefront API token. Pull this value from the
# configured Hydrogen environment; never commit or expose it to the browser.
PRIVATE_STOREFRONT_API_TOKEN=

# Placeholder reserved for future session-backed features. The current v3
# skeleton does not read it.

SESSION_SECRET=nottherealsessionsecret

# Required server-only Shopify Admin API credentials for newsletter and
# back-in-stock subscriptions. The token needs read_customers/write_customers
# and protected-customer-data approval. Requests pin stable Admin API 2026-07;
# see docs/admin-api.md for schema validation and the remaining live check.
# Never expose either value to browsers. ADMIN_STORE_DOMAIN defaults to
# PUBLIC_STORE_DOMAIN when it is myshopify.com.
ADMIN_ACCESS_TOKEN=
# ADMIN_STORE_DOMAIN=example.myshopify.com
